    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\n\n// Vapi sends the tool call nested like this:\n// body.message.toolCalls[0].function.arguments\n// and\n// body.message.toolCalls[0].id  (needed later to respond)\n\nconst toolCall = body?.message?.toolCalls?.[0];\nconst args = toolCall?.function?.arguments || {};\nconst toolCallId = toolCall?.id || '';\n\nreturn [{\n  json: {\n    toolCallId,\n    clientName: args.clientName || '',\n    companyName: args.companyName || '',\n    email: args.email || '',\n    serviceRequired: args.serviceRequired || '',\n    projectDescription: args.projectDescription || '',\n    budget: Number(String(args.budget || '').replace(/[^0-9.]/g, '')) || 0\n  }\n}];"
      },
      "id": "f1760e03-f4e4-48b4-9060-2711798af3fc",
      "name": "Extract Vapi Arguments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -944,
        16
      ],
      "notes": "Pulls the 6 fields out of Vapi's nested toolCalls[0].function.arguments payload. Adjust the path if your Vapi payload shape differs."
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-5.6-luna",
          "mode": "list",
          "cachedResultName": "GPT-5.6-LUNA"
        },
        "messages": {
          "values": [
            {
              "content": "You are a lead classification assistant. Given the project details, return ONLY valid JSON (no markdown, no extra text) with exactly these fields:\n{\n  \"service_category\": \"short category e.g. Web & Mobile Development, Branding, AI Automation\",\n  \"summary\": \"one sentence summary of what the client needs\",\n  \"next_action\": \"one short recommended next step, e.g. Schedule technical consultation\"\n}\nDo not include priority - that is calculated separately.",
              "role": "system"
            },
            {
              "content": "=Company: {{ $json.companyName }}\nService required: {{ $json.serviceRequired }}\nProject description: {{ $json.projectDescription }}\nBudget: {{ $json.budget }} PKR"
            }
          ]
        },
        "options": {}
      },
      "id": "e5a15333-6852-4101-a637-9db315b3b28f",
      "name": "AI Classification",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.5,
      "position": [
        -800,
        16
      ],
      "credentials": {
        "openAiApi": {
          "id": "uxWDZe1Y9fPTIjhQ",
          "name": "n8n free OpenAI API credits"
        }
      },
      "notes": "Swap for whichever AI node/provider you've been using (OpenAI, Anthropic, etc). Must output valid JSON only."
    },
    {
      "parameters": {
        "jsCode": "// Parse the AI's JSON response safely\nconst raw = $input.first().json.message?.content || $input.first().json.choices?.[0]?.message?.content || '{}';\n\nlet parsed;\ntry {\n  const cleaned = raw.replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = { service_category: 'Uncategorized', summary: '', next_action: 'Manual review needed' };\n}\n\n// Pull the original fields back in from the previous node (Extract Vapi Arguments)\nconst original = $('Extract Vapi Arguments').first().json;\n\nreturn [{\n  json: {\n    ...original,\n    service_category: parsed.service_category,\n    summary: parsed.summary,\n    next_action: parsed.next_action\n  }\n}];"
      },
      "id": "3dd149da-db9d-4e2f-87e5-d62001bef712",
      "name": "Parse AI Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -464,
        -160
      ]
    },
    {
      "parameters": {
        "jsCode": "const budget = Number($json.budget) || 0;\nlet priority;\n\nif (budget >= 500000) {\n  priority = 'High';\n} else if (budget >= 200000) {\n  priority = 'Medium';\n} else {\n  priority = 'Low';\n}\n\nreturn [{\n  json: {\n    ...$json,\n    priority,\n    status: 'New',\n    createdAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "52bbf689-fcb3-474d-b202-3c3181d82182",
      "name": "Calculate Priority",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -288,
        16
      ],
      "notes": "Deterministic priority - do NOT trust the AI to do this math. >=500000 HIGH, 200000-499999 MEDIUM, <200000 LOW."
    },
