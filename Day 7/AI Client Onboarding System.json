    {
      "parameters": {
        "jsCode": "const data = $('Calculate Priority').first().json;\n\nconst priority = data.priority;\nlet label;\n\nif (priority === 'High') {\n  label = 'HIGH PRIORITY CLIENT';\n} else if (priority === 'Medium') {\n  label = 'MEDIUM PRIORITY CLIENT';\n} else {\n  label = 'STANDARD CLIENT';\n}\n\nconst text = `*NEW CLIENT*\\n\\n*${label}*\\n\\n${data.clientName} - ${data.companyName}\\n\\nService: ${data.service_category}\\nBudget: PKR ${data.budget}\\nPriority: ${priority}\\n\\nAI Summary: ${data.summary}\\n\\nNext Action: ${data.next_action}\\n\\n_Airtable + Notion records created successfully._`;\n\nreturn [{ json: { ...data, slackText: text } }];"
      },
